/* Momentary layer, with host signals on the way in and out.
 *
 * Layers are momentary by default now, so there is no matching "return"
 * key to define -- releasing the thumb is the return.
 */
#define MO_MACRO(LYR)                          \
  mo_##LYR: momentary_##LYR {                  \
      compatible = "zmk,behavior-macro";       \
      #binding-cells = <0>;                    \
      wait-ms = <MC_LAYERS>;                   \
      tap-ms = <MC_LAYERS>;                    \
      bindings                                 \
          = <&macro_press &mo LYR>             \
          , <&macro_tap &kp F_##LYR>           \
          , <&macro_pause_for_release>         \
          , <&macro_release &mo LYR>           \
          , <&macro_tap &kp F_BAS>;            \
  };

/* Latch a layer on / off.
 *
 * &tog rather than &to, because &to switches every other layer off and
 * would take the MAC flag with it. Two macros rather than one self-inverse
 * binding so the host signal can say which way the toggle went.
 */
#define TOG_MACRO(LYR)                         \
  tog_##LYR##_on: toggle_##LYR##_on {          \
      compatible = "zmk,behavior-macro";       \
      #binding-cells = <0>;                    \
      tap-ms = <MC_LAYERS>;                    \
      bindings = <&tog LYR &kp F_##LYR>;       \
  };                                           \
  tog_##LYR##_off: toggle_##LYR##_off {        \
      compatible = "zmk,behavior-macro";       \
      #binding-cells = <0>;                    \
      tap-ms = <MC_LAYERS>;                    \
      bindings = <&tog LYR &kp F_BAS>;         \
  };
