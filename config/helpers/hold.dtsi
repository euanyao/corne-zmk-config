/* Hold for a modifier, tap for a behaviour rather than a keycode.
 * Used on MAC_STG's right home row -- see os/macos/hold/settings.dtsi.
 *
 * No positional guard here: it's a settings layer, not touch-typed. For
 * the real home row use &hml / &hmr from os/shared/hold/shared.dtsi.
 */
#define HR_HOLD(OS, LYR, MOD, MP)                   \
  hm_##OS##LYR##_##MOD: hold_hm_##OS##LYR##_##MOD { \
      compatible = "zmk,behavior-hold-tap";         \
      #binding-cells = <2>;                         \
      tapping-term-ms = <HR_TAPPING>;               \
      quick-tap-ms = <HR_QUICK_TAP>;                \
      flavor = HR_FLAVOR;                           \
      bindings = <&kp>, <&MP>;                      \
  };
