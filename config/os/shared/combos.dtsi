/* One set of combos now, rather than a mac copy and a windows copy.
 *
 * ZMK enables a combo when ANY of its listed layers is active, so listing
 * the typing layers works whether or not the MAC flag happens to be lit.
 */

/* The caps-word combos are GONE -- do not reintroduce them on home-row
 * positions. They sat on <16 19> and <14 21>, inherited from a QWERTY
 * config where those are F+J and S+L: home-row pairs that are not English
 * bigrams. This board is Colemak, so the same positions are T+N and R+I --
 * and "ri" is one of the commonest bigrams there is (right, bring, trip).
 *
 * Two separate faults resulted. Rolled under 80 ms, "ri" fired cw_OFF
 * instead of typing; above it, the home-row mods produced Ctrl+I. Both
 * keys also lost their immediacy, because ZMK withholds a key's output
 * while it is still a candidate for any combo -- which is why "te" (16+20,
 * in no combo) always felt crisper than "ri".
 *
 * Caps word now lives on the hold of pos 23 instead. See ht_CW.
 */

// Host signal: tell the AHK helper which layer is live, on demand.
#define HELP_COMBO(NAME, LYR)              \
  combo_help_##NAME {                      \
      bindings = <&kp LG(LC(F_##LYR))>;    \
      key-positions = <12 23>;             \
      slow-release;                        \
      layers = <LYR>;                      \
  };

HELP_COMBO(BAS, BAS)
HELP_COMBO(DEV, DEV)
HELP_COMBO(AXN, AXN)
HELP_COMBO(FNK_NAV, FNK_NAV)
HELP_COMBO(STG, STG)
