/* The five shared typing layers.
 *
 * Written once and used on both OSes. Windows-canonical throughout: the
 * primary shortcut modifier is Control, and macOS has Command/Control
 * swapped per-keyboard so the same keycodes land correctly there.
 *
 * Anything genuinely macOS-specific lives on the MAC overlay layers in
 * os/macos/keymap.dtsi -- do not add OS branches here.
 *
 * &trans means "this layer doesn't change this key" and falls through to
 * whatever is active below, which is ultimately BAS. The outer columns
 * (ESC, BSPC, DEL, RET, TAB) and the thumbs are bound once on BAS and
 * inherited everywhere, so they exist as a single binding rather than a
 * copy per layer. Only put a real binding above BAS where the layer
 * genuinely differs.
 */

        base_layer {
            /* The only layer that binds the outer columns and thumbs. */
            display-name = "BAS";
            bindings = <
    KEY_ESC  &kp Q  &kp W  &kp E  &kp R  &kp T        &kp Y  &kp U      &kp I    &kp O     &kp P  NAV_BSPC
    NAV_DEL   HR_A   HR_S   HR_D   HR_F  &kp G        &kp H   HR_J       HR_K     HR_L   HR_SEMI   KEY_RET
    KEY_TAB  &kp Z  &kp X  &kp C  &kp V  &kp B        &kp N  &kp M  &kp COMMA  &kp DOT  &kp FSLH   &kp SQT
                        THU_DEV  KEY_SPC  THU_AXN     THU_FNK  KEY_SPC  THU_STG
            >;
        };

        dev_layer {
            #define DV13  &hml  LGUI   AMPS
            #define DV14  &hml  LCTRL  LBRC
            #define DV15  &hml  LALT   RBRC
            #define DV16  &hml  LSHFT  EQUAL
            #define DV19  &hmr  RSHFT  EXCL
            #define DV20  &hmr  LALT   LBKT
            #define DV21  &hmr  RCTRL  RBKT
            #define DV22  &hmr  RGUI   PIPE

            display-name = "DEV";
            bindings = <
    &trans     &kp AT  &kp POUND  &kp DLLR  &kp PLUS   &kp DQT        &kp TILDE  &kp MINUS  &kp UNDER  &kp PRCNT  &kp CARET   &trans
    &trans       DV13       DV14      DV15      DV16   &kp SQT        &kp GRAVE       DV19       DV20       DV21       DV22   &trans
    &trans  &kp LC(R)  &kp LPAR  &kp RPAR  &kp ASTRK  &kp BSLH       &mp_sDEV_s  &kp QMARK     &kp LT     &kp GT  &mp_sDEV_ql  &kp F12
                            &trans  &trans  &trans        &trans  &trans  &trans
            >;
        };

        act_num_layer {
            /* Left hand navigation and clipboard, right hand numpad.
             * Fully shared -- there is no macOS overlay for this layer.
             *
             * Redo is Shift+Ctrl+Z rather than Ctrl+Y so it works on both:
             * Windows accepts either, and it lands as Shift+Cmd+Z on the
             * Mac. Ctrl+Y would have become Cmd+Y there.
             *
             * Two keys are Windows-shaped and do something different on
             * the Mac, kept because they went unused: position 17 (replace,
             * Ctrl+H) arrives as Cmd+H, which hides the window; position 35
             * (new virtual desktop) arrives as Ctrl+Cmd+D. */
            #define AX01  &kp  LA(LS(RIGHT))         // extend selection right
            #define AX13  &hml LGUI  LA(LS(LEFT))    // extend selection left
            #define AX14  &hml LCTRL LEFT
            #define AX15  &hml LALT  DOWN
            #define AX16  &hml LSHFT RIGHT
            #define AX19  &hmr LSHFT N4
            #define AX20  &hmr LALT  N5
            #define AX21  &hmr RCTRL N6
            #define AX22  &hmr RGUI  EQUAL

            display-name = "AXN";
            bindings = <
    &trans       AX01  &mp_a_prev    &kp UP    &mp_a_next     &kp LC(F)        &kp KP_PLUS  &kp N7  &kp N8  &kp N9  &kp KP_MULTIPLY        &trans
    &trans       AX13        AX14      AX15          AX16     &kp LC(H)             &kp N0    AX19    AX20    AX21             AX22        &trans
    &trans  &kp RC(Z)   &kp RC(X)  &kp RC(C)  &mp_a_paste  &kp RS(RC(Z))       &kp MINUS  &kp N1  &kp N2  &kp N3    &kp KP_DIVIDE  &kp LG(LC(D))
                            &trans  &trans  &tog_AXN_off        &trans  &trans  &trans
            >;
        };

        functions_layer {
            /* Sparse on purpose, and &trans rather than &none throughout,
             * so holding FNK over a latched AXN composes -- F-keys on the
             * left, numpad still live on the right. */
            #define FN13  &hml LGUI  F5
            #define FN14  &hml LCTRL F6
            #define FN15  &hml LALT  F7
            #define FN16  &hml LSHFT F8
            #define FN19  &hmr RSHFT HOME
            #define FN20  &hmr LALT  PG_DN
            #define FN21  &hmr RCTRL END

            display-name = "FNK";
            bindings = <
    &trans  &kp F9  &kp F10  &kp F11  &kp F12  &trans        &trans  &trans  &kp PG_UP  &trans     &trans  &trans
    &trans    FN13     FN14     FN15     FN16  &trans        &trans    FN19       FN20    FN21  &kp RGUI  &trans
    &trans  &kp F1   &kp F2   &kp F3   &kp F4  &trans        &trans  &trans     &trans  &trans     &trans  &trans
                            &trans  &trans  &trans        &trans  &trans  &trans
            >;
        };

        settings_layer {
            /* Left half is shared: bluetooth profiles (which also set the
             * OS), RGB, zoom, screenshot, studio unlock, bootloader.
             *
             * The right half is Windows tooling. macOS replaces four of
             * those positions via MAC_STG; the rest it simply inherits.
             *
             * Volume, mute and the media keys live here and only here.
             * They are OS-independent HID consumer codes, so duplicating
             * them per OS gained nothing and previously left macOS with no
             * media keys at all. */
            #define ST_UNLOCK  &mp_sSTG_cb           // tap: studio unlock | shift: clear profile | alt: clear all
            #define ST_SHOT    &mp_sSTG_screenshot
            #define ST_ZOOM_R  &mp_a_zoom_reset      // tap: zoom reset | shift: zoom reset (vscode)
            #define ST_RGB_C   &mp_sSTG_rgb_c
            #define ST_RGB_T   &mp_sSTG_rgb_t
            #define ST_RGB_U   &mp_sSTG_rgb_u
            #define ST_RGB_D   &mp_sSTG_rgb_d

            #define ST_MAG_IN  &kp LA(LG(SQT))       // windows magnifier in
            #define ST_MAG_RS  &kp LA(LG(N8))        // windows magnifier reset
            #define ST_MAG_OUT &kp LA(LG(MINUS))     // windows magnifier out
            #define ST_ZONES   &kp LG(LS(GRAVE))     // fancy zones
            #define ST_TASKMGR &kp LC(LS(ESC))       // task manager
            #define ST_SYSINFO &kp RG(PAUSE_BREAK)   // system info      | mac: mission control
            #define ST_SETTING &kp RG(I)             // windows settings
            #define ST_SECURE  &kp LC(LA(DEL))       // windows security | mac: application windows
            #define ST_INPUT   &kp LG(SPACE)         // input source     | mac: input source
            #define ST_FILES   &kp LG(E)             // file explorer    | mac: finder

            display-name = "STG";
            bindings = <
       &trans  &m_s_b1  &m_s_b2  ST_RGB_C  &kp LG(LS(C))   &kp RC(PLUS)        ST_MAG_IN   &kp C_VOL_DN     &kp C_MUTE  &kp C_VOL_UP    ST_ZONES  ST_TASKMGR
     ST_INPUT  &m_s_b3  &m_s_b4  &kp LALT        ST_SHOT      ST_ZOOM_R        ST_MAG_RS  &hmr RSHFT C_PREV  &hmr LALT C_PP  &kp C_NEXT  ST_SYSINFO  ST_SETTING
    ST_UNLOCK  &m_s_b5  &m_s_b6  ST_RGB_T       ST_FILES  &kp RC(MINUS)       ST_MAG_OUT         &trans         &trans    ST_RGB_U   ST_SECURE    ST_RGB_D
                     &kp C_BRI_DN  &mp_boot_l  &trans        &trans  &mp_boot_r  &kp C_BRI_UP
            >;
        };
