/* The five shared typing layers.
 *
 * Written once and used on both OSes. Windows-canonical throughout: the
 * primary shortcut modifier is Control, and macOS has Command/Control
 * swapped per-keyboard so the same keycodes land correctly there.
 *
 * Anything genuinely macOS-specific lives on the MAC overlay layers in
 * os/macos/keymap.dtsi -- do not add OS branches here.
 *
 * Thumbs above BAS are &trans wherever a layer has nothing specific to
 * put there, so space and the layer keys keep working everywhere. Only
 * AXN needs a thumb of its own, to unlatch.
 */

        base_layer {
            display-name = "BAS";
            bindings = <
    KEY_ESC  &kp Q  &kp W  &kp E  &kp R  &kp T          &kp Y   &kp U      &kp I     &kp O    &kp P     NAV_BSPC
    NAV_DEL   HR_A   HR_S   HR_D   HR_F  &kp G          &kp H    HR_J       HR_K      HR_L     HR_SEMI   KEY_RET
    KEY_TAB  &kp Z  &kp X  &kp C  &kp V  &kp B          &kp N   &kp M  &kp COMMA  &kp DOT  &kp FSLH     &kp SQT
                       THU_DEV  KEY_SPC  THU_AXN      THU_FNK  KEY_SPC   THU_STG
            >;
        };

        dev_layer {
            display-name = "DEV";
            bindings = <
    KEY_ESC     &kp AT  &kp POUND  &kp DLLR   &kp PLUS   &kp DQT        &kp TILDE  &kp MINUS  &kp UNDER  &kp PRCNT   &kp CARET  NAV_BSPC
    NAV_DEL  &hml LGUI AMPS  &hml LCTRL LBRC  &hml LALT RBRC  &hml LSHFT EQUAL  &kp SQT
                                                                       &kp GRAVE  &hmr RSHFT EXCL  &hmr LALT LBKT  &hmr RCTRL RBKT  &hmr RGUI PIPE  KEY_RET
    KEY_TAB  &kp LC(R)  &kp LPAR   &kp RPAR  &kp ASTRK  &kp BSLH       &mp_sDEV_s  &kp QMARK    &kp LT     &kp GT  &mp_sDEV_ql  &kp F12
                            &trans   &trans   &trans        &trans   &trans   &trans
            >;
        };

        act_num_layer {
            /* Left hand navigation and clipboard, right hand numpad.
             * Fully shared -- there is no macOS overlay for this layer.
             *
             * Redo is Shift+Ctrl+Z rather than Ctrl+Y so it works on both:
             * Windows accepts either, and it lands as Shift+Cmd+Z on the
             * Mac. Ctrl+Y would have become Cmd+Y there.
             *
             * Two keys are Windows-shaped and do something different on
             * the Mac, kept because they went unused: position 17 (replace,
             * Ctrl+H) arrives as Cmd+H, which hides the window; position 35
             * (new virtual desktop) arrives as Ctrl+Cmd+D. */
            display-name = "AXN";
            bindings = <
    KEY_ESC  &kp LA(LS(RIGHT))  &mp_a_prev  &kp UP  &mp_a_next  &kp LC(F)         &kp KP_PLUS  &kp N7  &kp N8  &kp N9  &kp KP_MULTIPLY  NAV_BSPC
    NAV_DEL  &hml LGUI LA(LS(LEFT))  &hml LCTRL LEFT  &hml LALT DOWN  &hml LSHFT RIGHT  &kp LC(H)
                                                                       &kp N0  &hmr LSHFT N4  &hmr LALT N5  &hmr RCTRL N6  &hmr RGUI EQUAL  KEY_RET
    KEY_TAB  &kp RC(Z)  &kp RC(X)  &kp RC(C)  &mp_a_paste  &kp RS(RC(Z))             &kp MINUS  &kp N1  &kp N2  &kp N3  &kp KP_DIVIDE  &kp LG(LC(D))
                            &trans   &trans   &tog_AXN_off        &trans   &trans   &trans
            >;
        };

        functions_layer {
            /* Empty slots are &trans, not &none, so holding FNK over a
             * latched AXN composes -- F-keys on the left, numpad still
             * live on the right. */
            display-name = "FNK";
            bindings = <
    KEY_ESC  &kp F9  &kp F10  &kp F11  &kp F12  &trans        &trans   &trans     &kp PG_UP   &trans   &trans    NAV_BSPC
    NAV_DEL  &hml LGUI F5  &hml LCTRL F6  &hml LALT F7  &hml LSHFT F8  &trans
                                                                &trans   &hmr RSHFT HOME  &hmr LALT PG_DN  &hmr RCTRL END  &kp RGUI  KEY_RET
    KEY_TAB  &kp F1  &kp F2   &kp F3   &kp F4  &trans         &trans   &trans     &trans   &trans   &trans    &trans
                            &trans   &trans   &trans        &trans   &trans   &trans
            >;
        };

        settings_layer {
            /* Left half is shared: bluetooth profiles (which also set the
             * OS), RGB, zoom, studio unlock, bootloader. The right half is
             * Windows tooling and is replaced wholesale by MAC_STG. */
            #define SET_BT_CLR  &mp_sSTG_cb          // tap: studio unlock | shift: clear profile | alt: clear all
            #define SET_ZOOM_R  &mp_a_zoom_reset     // tap: zoom reset | shift: zoom reset (vscode)
            #define SET_RGB_C   &mp_sSTG_rgb_c
            #define SET_RGB_T   &mp_sSTG_rgb_t
            #define SET_RGB_U   &mp_sSTG_rgb_u
            #define SET_RGB_D   &mp_sSTG_rgb_d

            display-name = "STG";
            bindings = <
    KEY_ESC  &m_s_b1  &m_s_b2  SET_RGB_C  &kp LG(LS(C))  &kp RC(PLUS)        &kp LA(LG(SQT))  &kp C_VOL_DN  &kp C_MUTE  &kp C_VOL_UP  &kp LG(LS(GRAVE))  &kp LC(LS(ESC))
    &kp LG(SPACE)  &m_s_b3  &m_s_b4  &kp LALT  &mp_sSTG_screenshot  SET_ZOOM_R
                                                    &kp LA(LG(N8))  &hmr RSHFT C_PREV  &hmr LALT C_PP  &kp C_NEXT  &kp RG(PAUSE_BREAK)  &kp RG(I)
    SET_BT_CLR  &m_s_b5  &m_s_b6  SET_RGB_T  &kp LG(E)  &kp RC(MINUS)        &kp LA(LG(MINUS))  &trans  &trans  SET_RGB_U  &kp LC(LA(DEL))  SET_RGB_D
                       &kp C_BRI_DN  &mp_boot_l  &trans        &trans  &mp_boot_r  &kp C_BRI_UP
            >;
        };
