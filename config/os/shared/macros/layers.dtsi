/* Momentary layers. DEV, FNK_NAV and STG are momentary-only via the outer
 * column holds -- releasing the key is the way back. */
MO_MACRO(DEV)
MO_MACRO(AXN)
MO_MACRO(FNK_NAV)
MO_MACRO(STG)

/* AXN is latchable: hold for momentary, tap to latch on. */
TOG_MACRO(AXN)

/* Hard reset to base.
 *
 * &to BAS switches every other layer off, WIN included, so the windows
 * variant has to relight it. Toggling after the clear is what makes this
 * idempotent: &to guarantees WIN is off, so &tog always turns it on.
 *
 * macOS is the unflagged default, so to_BAS needs no counterpart there.
 *
 * The trailing F_BAS signal tap was removed with the rest of the layer
 * signals -- see helpers/macros.dtsi.
 */
to_BAS: to_BAS_layer {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    tap-ms = <MC_LAYERS>;
    bindings = <&to BAS>;
};

to_BAS_win: to_BAS_win_layer {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    tap-ms = <MC_LAYERS>;
    bindings = <&to BAS &tog WIN>;
};

/* Caps Lock with an extended tap-ms so macOS registers it.
 * macOS debounces Caps Lock and ignores key events shorter than ~50 ms;
 * ZMK's &kp sends press+release in consecutive BLE packets (~7-15 ms),
 * which falls below that threshold. Holding for 50 ms is sufficient. */
m_caps: macro_caps {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    wait-ms = <0>;
    tap-ms = <200>;
    bindings = <&kp CLCK>;
};

/* Caps word, with a host signal so the indicator can follow it. */
cw_ON: cw_ON {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    bindings
        = <&kp LA(H_CWR)>
        , <&cw>;
};

cw_OFF: cw_OFF {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    bindings
        = <&kp LS(LC(H_CWR))>
        , <&kp K_CANCEL>;
};
