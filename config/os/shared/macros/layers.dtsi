/* Momentary layers. DEV, FNK and STG are momentary-only -- releasing the
 * thumb is the way back, so they need no return key anywhere. */
MO_MACRO(DEV)
MO_MACRO(AXN)
MO_MACRO(FNK)
MO_MACRO(NAV)
MO_MACRO(STG)

/* AXN and NAV are latchable: hold the thumb for momentary, tap to latch. */
TOG_MACRO(AXN)
TOG_MACRO(NAV)

/* Hard reset to base.
 *
 * &to BAS switches every other layer off, WIN included, so the windows
 * variant has to relight it. Toggling after the clear is what makes this
 * idempotent: &to guarantees WIN is off, so &tog always turns it on.
 *
 * macOS is the unflagged default, so to_BAS needs no counterpart there.
 */
to_BAS: to_BAS_layer {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    tap-ms = <MC_LAYERS>;
    bindings = <&to BAS &kp F_BAS>;
};

to_BAS_win: to_BAS_win_layer {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    tap-ms = <MC_LAYERS>;
    bindings = <&to BAS &tog WIN &kp F_BAS>;
};

/* Caps word, with a host signal so the indicator can follow it. */
cw_CAPS: cw_CAPS {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    tap-ms = <MC_TAP>;
    bindings
        = <&kp LS(H_CWR)>
        , <&kp CAPS>;
};

cw_ON: cw_ON {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    bindings
        = <&kp LA(H_CWR)>
        , <&cw>;
};

cw_OFF: cw_OFF {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    bindings
        = <&kp LS(LC(H_CWR))>
        , <&kp K_CANCEL>;
};
