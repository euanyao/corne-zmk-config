/* Bluetooth profile == OS mode.
 *
 * Selecting a profile also sets the OS: profiles 0-1 are the macOS work
 * laptop, 2-5 the Windows machines. Split 2/4 to match the actual device
 * count.
 *
 * &to BAS before &tog MAC is what makes these idempotent -- re-pressing
 * the same profile key must not flip the flag back off. &to clears every
 * layer including MAC, so the &tog that follows always turns it ON.
 */

#define BT_MAC(N, PROFILE)                          \
  m_s_b##N: macro_stg_bluetooth_##N {               \
      compatible = "zmk,behavior-macro";            \
      #binding-cells = <0>;                         \
      bindings = <&bt BT_SEL PROFILE &to_BAS_mac>;  \
  };

#define BT_WIN(N, PROFILE)                          \
  m_s_b##N: macro_stg_bluetooth_##N {               \
      compatible = "zmk,behavior-macro";            \
      #binding-cells = <0>;                         \
      bindings = <&bt BT_SEL PROFILE &to_BAS>;      \
  };

BT_MAC(1, 0)   // macOS work laptop
BT_MAC(2, 1)   // macOS spare
BT_WIN(3, 2)   // Windows
BT_WIN(4, 3)   // Windows
BT_WIN(5, 4)   // Windows spare
BT_WIN(6, 5)   // Windows spare

// mp_sSTG_cb
MORPH_KAS(
    s,
    STG,
    cb,
    clear_bluetooth,
    MOD_LALT,
    &studio_unlock,   // tap:   zmk studio unlock
    &bt BT_CLR,       // alt:   clear current profile
    &bt BT_CLR_ALL    // shift: clear all profiles
)
