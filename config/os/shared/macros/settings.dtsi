/* Bluetooth profile == OS mode.
 *
 * Selecting a profile also sets the OS: profiles 0-1 are the macOS work
 * laptop, 2-4 the Windows machines.
 *
 * FIVE PROFILES ARE BOUND, NOT SIX. FIVE IS THE nice!view CONVENTION.
 * The firmware still supports six -- ZMK_BLE_PROFILE_COUNT is
 * CONFIG_BT_MAX_PAIRED - CONFIG_ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS = 7 - 1
 * (app/include/zmk/ble.h) -- so profile index 5 exists and would pair
 * fine. It is unbound because NO nice!view status screen can indicate it:
 *
 *   ZMK's built-in nice_view screen  NICEVIEW_PROFILE_COUNT 5, drawn as a
 *   (widgets/util.h:11, status.c)    quincunx of 5 numbered circles, and
 *                                    clamped MIN(5, ZMK_BLE_PROFILE_COUNT)
 *   zmk-nice-oled nice_epaper        hardcoded `for (i = 0; i < 5; i++)`,
 *   (widgets/profile.c)              12px icons at 14px pitch = 4*14+12,
 *                                    exactly the 68px canvas; unclamped
 *
 * So five is a deliberate design on this panel, not a module bug -- six
 * would not fit either screen. [verified -- ZMK + module source, 2026-09-07]
 *
 * The module's only real defect is the missing clamp: index 5 stayed
 * selectable but lit nothing, because `i == active_profile_index` never
 * matched and the numeric readout is compiled out for epaper.
 *
 * BT_MAX_PAIRED stays at 7 deliberately: lowering it is what the reverted
 * 0acf415/fbcffa5 experiments did on unfounded reasoning. Leaving the
 * sixth profile present-but-unbound costs nothing and keeps bond storage
 * unchanged.
 *
 * Owner has three devices (1 macOS + 2 Windows), so five leaves two spare.
 * DO NOT bind a sixth key -- it is invisible on both screens, so there is
 * no fallback branch to switch to.
 *
 * macOS is the unflagged default, so the mac profiles just clear to base.
 * The windows profiles additionally light the WIN flag.
 *
 * &to BAS before &tog WIN is what makes these idempotent -- re-pressing
 * the same profile key must not flip the flag back off. &to clears every
 * layer including WIN, so the &tog that follows always turns it ON.
 *
 * Nothing detects the OS. This is convention: the keyboard believes
 * whatever the profile macro asserts, so pair the Mac to slot 0 or 1.
 */

#define BT_MAC(N, PROFILE)                      \
  m_s_b##N: macro_stg_bluetooth_##N {           \
      compatible = "zmk,behavior-macro";        \
      #binding-cells = <0>;                     \
      bindings = <&bt BT_SEL PROFILE &to_BAS>;  \
  };

#define BT_WIN(N, PROFILE)                          \
  m_s_b##N: macro_stg_bluetooth_##N {               \
      compatible = "zmk,behavior-macro";            \
      #binding-cells = <0>;                         \
      bindings = <&bt BT_SEL PROFILE &to_BAS_win>;  \
  };

BT_MAC(1, 0)   // macOS work laptop
BT_MAC(2, 1)   // macOS spare
BT_WIN(3, 2)   // Windows PC 1
BT_WIN(4, 3)   // Windows PC 2
BT_WIN(5, 4)   // Windows spare
               // profile 5 intentionally unbound -- see the header comment

/* mp_sSTG_cb -- clearing bluetooth bonds.
 *
 * Was a three-way morph sharing a key with the ZMK Studio unlock, because
 * STG had no free positions. It does now, so unlock is its own key and
 * clearing is down to two variants.
 *
 * BT_CLR_ALL stays behind shift on purpose: it wipes every profile the
 * firmware has (all six, including the unbound one) plus the split bond,
 * and clearing bonds is the one repair that does NOT need the physical
 * reset button, so it wants a guard rather than a bare key.
 *
 * Note [verified on hardware, CLAUDE.md 3.5]: BT_CLR_ALL froze the central
 * and needed a power-cycle. Expect that; it is not damage. */
MORPH_KS(
    s,
    STG,
    cb,
    clear_bluetooth,
    &bt BT_CLR,       // tap:   clear the current profile
    &bt BT_CLR_ALL    // shift: clear ALL profiles
)
