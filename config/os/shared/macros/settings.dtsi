/* Bluetooth profile == OS mode.
 *
 * Selecting a profile also sets the OS: profiles 0-1 are the macOS work
 * laptop, 2-5 the Windows machines.
 *
 * macOS is the unflagged default, so the mac profiles just clear to base.
 * The windows profiles additionally light the WIN flag.
 *
 * &to BAS before &tog WIN is what makes these idempotent -- re-pressing
 * the same profile key must not flip the flag back off. &to clears every
 * layer including WIN, so the &tog that follows always turns it ON.
 *
 * Nothing detects the OS. This is convention: the keyboard believes
 * whatever the profile macro asserts, so pair the Mac to slot 0 or 1.
 */

#define BT_MAC(N, PROFILE)                      \
  m_s_b##N: macro_stg_bluetooth_##N {           \
      compatible = "zmk,behavior-macro";        \
      #binding-cells = <0>;                     \
      bindings = <&bt BT_SEL PROFILE &to_BAS>;  \
  };

#define BT_WIN(N, PROFILE)                          \
  m_s_b##N: macro_stg_bluetooth_##N {               \
      compatible = "zmk,behavior-macro";            \
      #binding-cells = <0>;                         \
      bindings = <&bt BT_SEL PROFILE &to_BAS_win>;  \
  };

BT_MAC(1, 0)   // macOS work laptop
BT_MAC(2, 1)   // macOS spare
BT_WIN(3, 2)   // Windows PC 1
BT_WIN(4, 3)   // Windows PC 2
BT_WIN(5, 4)   // Windows spare
BT_WIN(6, 5)   // Windows spare

/* mp_sSTG_cb -- clearing bluetooth bonds.
 *
 * Was a three-way morph sharing a key with the ZMK Studio unlock, because
 * STG had no free positions. It does now, so unlock is its own key and
 * clearing is down to two variants.
 *
 * BT_CLR_ALL stays behind shift on purpose: it wipes all six profiles, and
 * clearing bonds is the one repair that does NOT need the physical reset
 * button, so it wants a guard rather than a bare key. */
MORPH_KS(
    s,
    STG,
    cb,
    clear_bluetooth,
    &bt BT_CLR,       // tap:   clear the current profile
    &bt BT_CLR_ALL    // shift: clear ALL profiles
)
