/* DEV, AXN, FNK, STG -- layers 2 to 5, shared by both OSes.
 *
 * MAC-CANONICAL. Anything genuinely Windows-specific lives on the WIN
 * overlays in os/windows/keymap/ -- do not add OS branches here.
 *
 * All four are &trans at positions 0, 11 and 12 so the WIN flag can
 * override word-delete and the ESC panic from underneath. Binding any of
 * those for real here silently breaks that -- see os/shared/layers.dtsi.
 *
 * Use &none, not &trans, where a layer wants a key to do nothing: &trans
 * falls through to BAS and types a letter.
 */

        dev_layer {
            #define DV13  &hml  LGUI   AMPS
            #define DV14  &hml  LCTRL  LBRC
            #define DV15  &hml  LALT   RBRC
            #define DV16  &hml  LSHFT  EQUAL
            #define DV19  &hmr  RSHFT  EXCL
            #define DV20  &hmr  LALT   LBKT
            #define DV21  &hmr  RCTRL  RBKT
            #define DV22  &hmr  RGUI   PIPE

            display-name = "DEV";
            bindings = <
    &trans     &kp AT  &kp POUND  &kp DLLR  &kp PLUS   &kp DQT        &kp TILDE  &kp MINUS  &kp UNDER  &kp PRCNT    &kp CARET   &trans
    &trans       DV13       DV14      DV15      DV16   &kp SQT        &kp GRAVE       DV19       DV20       DV21         DV22   &trans
    &trans  &kp LG(R)  &kp LPAR  &kp RPAR  &kp ASTRK  &kp BSLH       &mp_sDEV_s  &kp QMARK     &kp LT     &kp GT  &mp_sDEV_ql  &kp F12
                            &trans  &trans  &trans        &trans  &trans  &trans
            >;
        };

        act_num_layer {
            /* Left hand navigation and clipboard, right hand numpad.
             * Fully shared -- there is no Windows overlay for this layer.
             *
             * Several keys happen to work on both OSes without help:
             *   - Option/Alt+Shift+arrows extends selection by word on the
             *     Mac and expands selection in VS Code on Windows.
             *   - Redo is Shift+Cmd+Z, which arrives as Shift+Ctrl+Z on
             *     Windows and is accepted there as redo.
             */
            #define AX01  &kp  LA(LS(RIGHT))         // extend selection right
            #define AX05  &kp  LG(F)                 // find
            #define AX13  &hml LGUI  LA(LS(LEFT))    // extend selection left
            #define AX14  &hml LCTRL LEFT
            #define AX15  &hml LALT  DOWN
            #define AX16  &hml LSHFT RIGHT
            #define AX17  &kp  LA(LG(F))             // replace (Opt+Cmd+F)
            #define AX19  &hmr LSHFT N4
            #define AX20  &hmr LALT  N5
            #define AX21  &hmr RCTRL N6
            #define AX22  &hmr RGUI  EQUAL

            display-name = "AXN";
            bindings = <
    &trans       AX01  &mp_a_prev     &kp UP    &mp_a_next          AX05        &kp KP_PLUS  &kp N7  &kp N8  &kp N9  &kp KP_MULTIPLY  &trans
    &trans       AX13        AX14       AX15         AX16          AX17             &kp N0    AX19    AX20    AX21             AX22  &trans
    &trans  &kp RG(Z)   &kp RG(X)  &kp RG(C)  &mp_a_paste  &kp RS(RG(Z))         &kp MINUS  &kp N1  &kp N2  &kp N3    &kp KP_DIVIDE  &trans
                            &trans  &trans  &tog_AXN_off        &trans  &trans  &trans
            >;
        };

        functions_layer {
            /* F-keys on the left, host media controls on the right.
             *
             * The media block moved here from STG: volume, transport and
             * screen brightness are OS-independent HID consumer codes, so
             * they need no overlay, but they are host controls rather than
             * keyboard configuration and STG is now config-only.
             *
             * HOME/END/PgUp/PgDn used to sit on the right here. They are on
             * NAV now, which owns navigation -- these were the duplicates.
             *
             * Row 2 and the thumbs stay &trans so holding FNK over a latched
             * AXN still composes: F-keys left, bottom numpad row live on the
             * right. Rows 0 and 1 no longer compose, which is the price of
             * putting media here. */
            #define FN13  &hml LGUI  F5
            #define FN14  &hml LCTRL F6
            #define FN15  &hml LALT  F7
            #define FN16  &hml LSHFT F8

            display-name = "FNK";
            bindings = <
    &trans  &kp F9  &kp F10  &kp F11  &kp F12  &trans        &kp C_BRI_DN  &kp C_VOL_DN  &kp C_MUTE  &kp C_VOL_UP  &kp C_BRI_UP  &trans
    &trans    FN13     FN14     FN15     FN16  &trans              &trans    &kp C_PREV    &kp C_PP    &kp C_NEXT        &trans  &trans
    &trans  &kp F1   &kp F2   &kp F3   &kp F4  &trans              &trans        &trans      &trans        &trans        &trans  &trans
                            &trans  &trans  &trans        &trans  &trans  &trans
            >;
        };

        nav_layer {
            /* Navigation, consolidated. Arrows were on AXN and
             * HOME/END/PgUp/PgDn on FNK, which split the cluster across two
             * layers -- and AXN's arrows sat on the same hand as its thumb.
             *
             * Held by the RIGHT thumb (pos 41), so the arrows live on the
             * LEFT hand and every combination is cross-hand.
             *
             * Modifiers are plain &kp on the right home row rather than
             * hold-taps: they exist to be held while the left hand arrows,
             * so there is no tap to disambiguate. Shift+arrow selects,
             * Alt+arrow jumps by word on macOS.
             *
             * &none, not &trans, on unused positions -- &trans would fall
             * through to BAS and type letters mid-navigation. The outer
             * columns and thumbs stay &trans so ESC/BSPC/DEL/quote/TAB/RET
             * and both spaces keep working, and positions 0, 11 and 12 must
             * stay &trans so the WIN flag still wins there.
             *
             * Bottom row is deliberately free for later.
             *
             * Thumb 41 carries tog_NAV_off rather than &trans, so tapping it
             * again unlatches -- and the host signal knows which way the
             * toggle went. Same pattern AXN uses at position 38. */
            #define NV19  &kp RSHFT                  // select with the arrows
            #define NV20  &kp LALT                   // word jump (macOS)
            #define NV21  &kp RCTRL
            #define NV22  &kp RGUI

            display-name = "NAV";
            bindings = <
    &trans  &none  &kp PG_UP     &kp UP  &kp PG_DN     &none        &none  &none  &none  &none  &none  &trans
    &trans  &kp HOME  &kp LEFT  &kp DOWN  &kp RIGHT  &kp END        &none   NV19   NV20   NV21   NV22  &trans
    &trans  &none      &none      &none      &none     &none        &none  &none  &none  &none  &none  &trans
                            &trans  &trans  &trans        &trans  &trans  &tog_NAV_off
            >;
        };

        settings_layer {
            /* Keyboard configuration ONLY -- bootloader, bluetooth, RGB,
             * ZMK Studio and the OS flag. Nothing host-facing.
             *
             * Volume, media transport and screen brightness were removed
             * too. They are OS-independent HID consumer codes so they need
             * no overlay, but they are host controls rather than keyboard
             * config, and are currently bound NOWHERE. FNK has the room.
             *
             * Deliberately carries NO host application shortcuts. The 13
             * that used to live here (zoom, accessibility zoom, screenshot,
             * input source, Finder, Mission Control, force quit, app
             * windows) were the sole reason WIN_STG existed; dropping them
             * let that whole conditional layer go.
             *
             * Consequences worth preserving:
             *   - STG is now OS-independent. Nothing sits above it, so the
             *     class of bug where an overlay silently shadowed the
             *     bootloader keys cannot recur.
             *   - There is room again. BT_CLR is on its own key rather than
             *     buried behind Alt, and 20-odd positions are free.
             *
             * If host shortcuts are wanted later they belong on FNK with a
             * WIN_FNK conditional overlay -- same pattern WIN_STG used, on
             * the layer that has the space for it.
             *
             * &none rather than &trans on unused positions: &trans would
             * fall through to BAS and type a letter. */
            #define ST_UNLOCK  &studio_unlock        // zmk studio unlock
            #define ST_BTCLR   &mp_sSTG_cb           // tap: clear profile | shift: clear ALL profiles
            #define ST_RGB_C   &mp_sSTG_rgb_c
            #define ST_RGB_T   &mp_sSTG_rgb_t
            #define ST_RGB_U   &mp_sSTG_rgb_u
            #define ST_RGB_D   &mp_sSTG_rgb_d

            /* OS mode toggle, decoupled from the bluetooth profile.
             *
             * The profile macros set the OS as a side effect, which is fine
             * on BLE but leaves two gaps: connecting over USB doesn't touch
             * the profile, and deep-sleep wake resets layer state so the
             * flag is lost while the profile survives. */
            #define ST_OS_TOG   &tog WIN             // macOS <-> Windows mode

            /* Bootloader, one per half, at the top outer corners.
             *
             * ZMK reset behaviours are source-locality -- they act on the
             * half the key physically sits on -- so each half needs its own
             * binding. Position 0 is left, 11 is right.
             *
             * Reached cross-hand: hold STG on one half (TAB pos 24 or RET
             * pos 35), press the boot key on the other. That is why STG is
             * bound on both halves; a single thumb-held STG cannot reach a
             * boot key on its own half.
             *
             * The case covers the physical reset button, so this is the only
             * route into DFU. Do NOT put these behind a combo -- combos
             * always run on the central and would reset the left half twice.
             *
             * Nothing sits above STG any more, so nothing can shadow these. */
            #define ST_BOOT_L   &bootloader          // DFU, LEFT half
            #define ST_BOOT_R   &bootloader          // DFU, RIGHT half

            display-name = "STG";
            bindings = <
   ST_BOOT_L  &m_s_b1  &m_s_b2  ST_RGB_C  &none  &none        &none      &none  &none     &none  &none  ST_BOOT_R
       &none  &m_s_b3  &m_s_b4  ST_BTCLR  &none  &none        &none      &none  &none     &none  &none      &none
   ST_UNLOCK  &m_s_b5    &none  ST_RGB_T  &none  &none        &none  ST_OS_TOG  &none  ST_RGB_U  &none   ST_RGB_D
                            &none  &trans  &trans        &trans  &trans  &none
            >;
        };
