/* Settings-layer behaviours on the default (macOS) side.
 *
 * Mac-canonical: Command is LGUI. Comments state the chord as macOS sees
 * it.
 */

/* Screenshot. Shift+Cmd+5/4/3 on the Mac.
 *
 * Pre-existing gap carried over unchanged: these are macOS shortcuts and
 * do nothing on Windows, which wants Win+Shift+S. The old config had the
 * same problem, so it's not a regression, but it's worth fixing. */
MORPH_KAS(
    s,
    STG,
    screenshot,
    screenshot,
    MOD_LALT,
    &kp RS(RG(N5)),  // tap:   screenshot and recording options
    &kp RS(RG(N4)),  // alt:   screenshot of selected area
    &kp RS(RG(N3))   // shift: screenshot of whole screen
)

/* Finder. Was macOS-only on an overlay; it's on the default layer now. */
MORPH_KS(
    s,
    STG,
    f,
    files,
    &kp LA(LG(SPACE)),  // tap:   finder                  (Opt+Cmd+Space)
    &kp LS(LG(DOT))     // shift: show/hide system files  (Shift+Cmd+.)
)
