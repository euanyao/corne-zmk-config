// mp_sSTG_rgb_t -- on/off, plus effect cycling behind modifiers
MORPH_KAS(
    s,
    STG,
    rgb_t,
    rgb_toggle,
    MOD_LALT,
    &rgb_ug RGB_TOG,  // tap:   underglow on/off
    &rgb_ug RGB_EFR,  // alt:   previous effect
    &rgb_ug RGB_EFF   // shift: next effect
)

// mp_sSTG_rgb_c -- colour on a plain tap, no chord needed
MORPH_KS(
    s,
    STG,
    rgb_c,
    rgb_colour,
    &rgb_ug RGB_HUI,  // tap:   colour forward
    &rgb_ug RGB_HUD   // shift: colour back
)

// mp_sSTG_rgb_u
MORPH_KS(
    s,
    STG,
    rgb_u,
    rgb_up,
    &rgb_ug RGB_BRI,  // tap:   brightness up
    &rgb_ug RGB_SAI   // shift: saturation up
)

// mp_sSTG_rgb_d
MORPH_KS(
    s,
    STG,
    rgb_d,
    rgb_down,
    &rgb_ug RGB_BRD,  // tap:   brightness down
    &rgb_ug RGB_SAD   // shift: saturation down
)
