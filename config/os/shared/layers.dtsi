/* Layer indices.
 *
 * Order is load bearing. WIN must sit ABOVE the typing layers so its
 * overrides win while any of them is active; the conditional overlay must
 * sit above WIN. Reordering these silently changes which binding wins at a
 * position, and check-keymap.sh asserts the keymap node order matches.
 *
 * BAS is layer 0 and is therefore always active -- everything above it
 * falls through to it via &trans.
 *
 * macOS is the unflagged default. The Mac needs no host-side
 * configuration at all; the Windows machines carry a Win/Ctrl remap
 * (PowerToys) instead. See os/shared/keys.dtsi.
 */
#define BAS      0
#define DEV      1
#define AXN      2
#define FNK      3
#define STG      4
#define WIN      5   /* OS flag. Lit = Windows. Nearly all &trans. */
#define WIN_STG  6   /* conditional: WIN + STG */

/* Host signal keys.
 *
 * Tapped alongside layer changes so host-side helpers (host/windows/ahk)
 * can show which layer is live. These were already identical between the
 * old mac and windows sets, so merging the layers didn't change them.
 */
#define H_CWR   F13
#define F_BAS   LS(F14)
#define F_DEV   LS(F15)
#define F_AXN   LS(F16)
#define F_FNK   LS(F17)
#define F_STG   LS(F18)
