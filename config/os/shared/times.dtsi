/* Home Row
 *
 * "balanced" settles the hold on the OTHER key's RELEASE (HT_OTHER_KEY_UP),
 * and settles as a TAP if this key comes up first (HT_KEY_UP). Verified in
 * behavior_hold_tap.c. Consequence: a fast roll that lifts the modifier
 * before the other key resolves to a tap, so the chord is lost.
 *
 * "hold-preferred" settles on HT_OTHER_KEY_DOWN instead and does not have
 * that failure. It was tried and reverted, so this is deliberate -- change
 * it only on purpose. QMK equivalents: balanced = PERMISSIVE_HOLD,
 * hold-preferred = HOLD_ON_OTHER_KEY_PRESS.
 */
#define HR_FLAVOR     "balanced"
/* The timer path. With "balanced" a hold settles three ways: the other
 * key's release, this key's release (tap), or this timer expiring.
 * Set high (280 ms) so the timer is rarely the deciding factor --
 * require-prior-idle-ms and balanced-flavor carry most cases.
 * The timer only fires for solo mod holds and same-hand mod+alpha
 * while the other hand is on the mouse. */
#define HR_TAPPING    280
/* Rapid re-press of a hold-tap forces tap (enables key repeat, protects
 * fast same-key sequences like "ll", "ss"). 175 ms covers ~300 WPM
 * re-press rate, which is realistic fast typing. */
#define HR_QUICK_TAP  175
/* Immediately resolve as tap when the previous key was pressed within
 * this window -- eliminates typing delays during normal flow.
 * Formula: 10500 / WPM. 175 ms covers ~60 WPM (ergo keyboard baseline). */
#define HR_PRIOR_IDLE 175

/* Mod Tap */
#define MT_TAPPING      220
#define MT_QUICK_TAP    200
#define MT_PRIOR_IDLE   150

/* Hold Tap Preferred */
#define HP_TAPPING    220
#define HP_QUICK_TAP  200

/* Macro */
#define MC_WAIT_START 400
#define MC_WAIT       100
#define MC_TAP        200
#define MC_LAYERS       0

/* Key Positions
 *
 * Finger blocks and thumbs are listed separately so home-row mods can be
 * made positional: a left-hand mod only holds when the next key is on the
 * right block or on either thumb, and vice versa. That is what stops a
 * same-hand roll like "as" or "sd" being read as a modifier chord.
 *
 * Thumbs are in both trigger lists on purpose -- without that you lose
 * mod + layer-thumb chords such as Ctrl + AXN-arrow for word jumps.
 */
#define KP_LEFT       0   1   2   3   4   5  12  13  14  15  16  17  24  25  26  27  28  29
#define KP_RIGHT      6   7   8   9  10  11  18  19  20  21  22  23  30  31  32  33  34  35
#define KP_THUMB     36  37  38  39  40  41
