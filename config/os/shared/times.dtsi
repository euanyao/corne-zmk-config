/* Home Row
 *
 * "hold-preferred" settles the hold as soon as ANOTHER KEY IS PRESSED, so
 * rolling a modifier into the next key produces a chord rather than two
 * letters. From behavior_hold_tap.c:
 *
 *     hold-preferred   HT_OTHER_KEY_DOWN -> hold
 *     balanced         HT_OTHER_KEY_UP   -> hold, and HT_KEY_UP -> tap
 *
 * "balanced" was the previous setting, and it waits for the other key to be
 * RELEASED. In a fast roll the modifier comes up first, so HT_KEY_UP fires
 * and it resolves to a tap. That was the "rolling gives two keypresses"
 * problem.
 *
 * This is only safe because hold-trigger-key-positions restricts holds to
 * cross-hand and thumb sequences -- a same-hand roll cannot fire a modifier
 * whatever the flavor says. The positional guard does the safety work,
 * which frees the flavor to be aggressive. QMK documents the same pairing:
 * Chordal Hold "is intended to be used together with either Permissive Hold
 * or Hold On Other Key Press".
 *
 * QMK equivalents, for reference:
 *     hold-preferred  =  HOLD_ON_OTHER_KEY_PRESS
 *     balanced        =  PERMISSIVE_HOLD
 */
#define HR_FLAVOR     "hold-preferred"
#define HR_TAPPING    220
#define HR_QUICK_TAP  125

/* Mod Tap */
#define MT_TAPPING    220
#define MT_QUICK_TAP  200

/* Hold Tap Preferred */
#define HP_TAPPING    220
#define HP_QUICK_TAP  200

/* Macro */
#define MC_WAIT_START 400
#define MC_WAIT       100
#define MC_TAP        200
#define MC_LAYERS       0

/* Key Positions
 *
 * Finger blocks and thumbs are listed separately so home-row mods can be
 * made positional: a left-hand mod only holds when the next key is on the
 * right block or on either thumb, and vice versa. That is what stops a
 * same-hand roll like "as" or "sd" being read as a modifier chord.
 *
 * Thumbs are in both trigger lists on purpose -- without that you lose
 * mod + layer-thumb chords such as Ctrl + AXN-arrow for word jumps.
 */
#define KP_LEFT       0   1   2   3   4   5  12  13  14  15  16  17  24  25  26  27  28  29
#define KP_RIGHT      6   7   8   9  10  11  18  19  20  21  22  23  30  31  32  33  34  35
#define KP_THUMB     36  37  38  39  40  41
