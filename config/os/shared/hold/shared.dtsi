// ESC-hold on WIN relights the OS flag that &to clears.
to_BAS_win_kp: to_BAS_win_kp {
    compatible = "zmk,behavior-hold-tap";
    #binding-cells = <2>;
    tapping-term-ms = <HP_TAPPING>;
    flavor = "hold-preferred";
    bindings = <&to_BAS_win>, <&kp>;
};

// STG on hold, key on tap. Used on pos 0 (ESC) and pos 11 (COMMA) so
// either hand can hold STG while the other reaches a bootloader key.
ht_STG: hold_tap_STG {
    compatible = "zmk,behavior-hold-tap";
    #binding-cells = <2>;
    tapping-term-ms = <HP_TAPPING>;
    flavor = "hold-preferred";
    bindings = <&mo_STG>, <&kp>;
};

// LGUI on hold, key on tap. Used on pos 24 (Caps Lock via m_caps) and
// pos 35 (backslash/pipe via mp_bslh_pipe). WIN overlay substitutes
// LCTRL for LGUI so the primary modifier stays on the same finger.
ht_LGUI_caps: hold_tap_LGUI_caps {
    compatible = "zmk,behavior-hold-tap";
    #binding-cells = <2>;
    tapping-term-ms = <HP_TAPPING>;
    flavor = "hold-preferred";
    bindings = <&kp>, <&m_caps>;
};

ht_LGUI_bslh: hold_tap_LGUI_bslh {
    compatible = "zmk,behavior-hold-tap";
    #binding-cells = <2>;
    tapping-term-ms = <HP_TAPPING>;
    flavor = "hold-preferred";
    bindings = <&kp>, <&mp_bslh_pipe>;
};

// DEV on hold, key on tap. Used on outer-column keys (pos 12/23).
ht_DEV_kp: hold_tap_DEV_kp {
    compatible = "zmk,behavior-hold-tap";
    #binding-cells = <2>;
    tapping-term-ms = <HP_TAPPING>;
    flavor = "hold-preferred";
    bindings = <&mo_DEV>, <&kp>;
};

