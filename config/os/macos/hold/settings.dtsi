/* Right home row on MAC_STG: hold for a modifier, tap for a window action.
 *
 * The left home row used to carry hm_mSTG_LC / hm_mSTG_LS as well, but the
 * left half of STG is shared now and those are gone.
 */
HR_HOLD(m, STG, RS, mp_mSTG_left)       //hm_mSTG_RS
HR_HOLD(m, STG, RA, mp_mSTG_rectangle)  //hm_mSTG_RA
