/* macOS window management (Rectangle) and IDE controls.
 *
 * IMPORTANT: written Windows-canonical, like the rest of the config. The
 * Mac has Command and Control swapped for this keyboard, so:
 *
 *     you want Command  ->  write LC / RC
 *     you want Control  ->  write LG / RG
 *
 * Option and Shift are unaffected. Comments state the macOS chord as the
 * OS sees it, not the keycode.
 */

// mp_mSTG_f
MORPH_KS(
    m,
    STG,
    f,
    files,
    &kp LA(LC(SPACE)),  // tap:   finder                  (Opt+Cmd+Space)
    &kp LS(LC(DOT))     // shift: show/hide system files  (Shift+Cmd+.)
)

// mp_mSTG_topleft
MORPH_KA(
    m,
    STG,
    topleft,
    topleft,
    MOD_LALT,
    &kp LS(LC(E)),               // tap: ide explorer        (Shift+Cmd+E)
    &kp LS(LA(LC(LG(LEFT))))     // alt: rectangle top left
)

// mp_mSTG_up
MORPH_KA(
    m,
    STG,
    up,
    up,
    MOD_LALT,
    &kp LS(LG(G)),               // tap: ide source control  (Shift+Ctrl+G)
    &kp LS(LA(LC(UP)))           // alt: rectangle top half
)

// mp_mSTG_topright
MORPH_KA(
    m,
    STG,
    topright,
    topright,
    MOD_LALT,
    &kp LS(LC(D)),               // tap: ide debugger        (Shift+Cmd+D)
    &kp LS(LA(LC(LG(RIGHT))))    // alt: rectangle top right
)

// mp_mSTG_left
MORPH_KA(
    m,
    STG,
    left,
    left,
    MOD_LALT,
    &kp LC(B),                   // tap: ide primary side bar  (Cmd+B)
    &kp LA(LC(LS(LEFT)))         // alt: rectangle left
)

// mp_mSTG_rectangle
MORPH_KAS(
    m,
    STG,
    rectangle,
    rectangle,
    MOD_LALT,
    &kp LA(LG(F)),               // tap:   maximize   (Opt+Ctrl+F)
    &kp LA(LG(BACKSPACE)),       // alt:   restore
    &kp LS(LA(LG(F)))            // shift: center
)

// mp_mSTG_right
MORPH_KA(
    m,
    STG,
    right,
    right,
    MOD_LALT,
    &kp LA(LC(B)),               // tap: ide secondary side bar  (Opt+Cmd+B)
    &kp LA(LC(LS(RIGHT)))        // alt: rectangle right
)

// mp_mSTG_downleft
MORPH_KA(
    m,
    STG,
    downleft,
    downleft,
    MOD_LALT,
    &none,                       // tap: none
    &kp LA(LC(LG(LEFT)))         // alt: rectangle bottom left
)

// mp_mSTG_down
MORPH_KA(
    m,
    STG,
    down,
    down,
    MOD_LALT,
    &kp LC(J),                   // tap: ide bottom panel  (Cmd+J)
    &kp LS(LA(LC(DOWN)))         // alt: rectangle bottom half
)

// mp_mSTG_downright
MORPH_KA(
    m,
    STG,
    downright,
    downright,
    MOD_LALT,
    &none,                       // tap: none
    &kp LA(LC(LG(RIGHT)))        // alt: rectangle bottom right
)

// mp_mSTG_m
MORPH_KS(
    m,
    STG,
    m,
    mute,
    &kp C_MUTE,                  // tap:   volume mute
    &kp LS(LA(LG(LC(M))))        // shift: mic mute (all four mods, so the swap is a no-op)
)
