/* Windows screenshot -- the counterpart to mp_sSTG_screenshot on STG.
 *
 * The shared layer's screenshot is macOS-shaped (Shift+Cmd+5/4/3) and does
 * nothing on Windows, which was the last genuine OS gap left in the config:
 * WIN_STG covered every other macOS-only settings key but not this one.
 *
 * Keycode convention (os/shared/keys.dtsi): on the Windows machines a
 * firmware LGUI arrives as Control and LCTRL as the Win key, so
 * **want the Win key -> write LC**. LC(LS(S)) is therefore Win+Shift+S.
 *
 * macOS maps three variants onto its key; Windows only has two worth
 * binding, so this is MORPH_KS rather than MORPH_KAS:
 *   Win+Shift+S  region snip, the everyday one
 *   PrintScreen  whole screen to the clipboard, mirroring the Mac's
 *                shift -> Shift+Cmd+3 (whole screen)
 */
MORPH_KS(
    w,
    STG,
    shot,
    screenshot,
    &kp LC(LS(S)),   // tap:   snip a region   (Win+Shift+S)
    &kp PRINTSCREEN  // shift: whole screen to the clipboard
)
