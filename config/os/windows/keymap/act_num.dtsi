        win_act_num_layer {
            /* WIN_AXN -- conditional on <WIN AXN>.
             *
             * Overrides the nine AXN positions whose macOS chord has no
             * Windows equivalent. Everything else is &trans and falls
             * through to the shared AXN layer.
             *
             * This is what removes the PowerToys dependency: the firmware
             * emits the native Windows keycode instead of relying on the
             * host to translate a Cmd into a Control. Without it, AXN's
             * clipboard cluster arrives as Win+Z/X/C/V and opens snap
             * layouts, the power-user menu, Copilot and clipboard history.
             *
             * Redo is Ctrl+Y here rather than Ctrl+Shift+Z: both work in
             * most Windows apps, Ctrl+Y is the more universal.
             *
             * Replace is Ctrl+H, which is why it needs an override at all --
             * macOS uses Opt+Cmd+F and there is no shared chord.
             *
             * NOT overridden, deliberately: the home-row mods at 13-16 and
             * 19-22. Positions 14 and 21 carry LGUI, which is the Win key
             * here rather than Control, so on Windows the Control mod is on
             * A and ; (13/22) instead of S and L. Fixing that needs one
             * overlay per typing layer -- the duplication this architecture
             * exists to avoid. See CLAUDE.md §3.1.
             */
            display-name = "WIN_AXN";
            bindings = <
    &trans  &trans  &mp_wa_prev  &trans  &mp_wa_next  &kp LC(F)        &trans  &trans  &trans  &trans  &trans  &trans
    &trans  &trans       &trans  &trans       &trans  &kp LC(H)        &trans  &trans  &trans  &trans  &trans  &trans
    &trans  &kp LC(Z)  &kp LC(X)  &kp LC(C)  &mp_wa_paste  &kp LC(Y)   &trans  &trans  &trans  &trans  &trans  &trans
                            &trans  &trans  &trans        &trans  &trans  &trans
            >;
        };
